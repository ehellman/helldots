/* Vercel/Next.js style monochrome theme */

* {
    /* Background scale */
    bg:           #000000;
    bg-alt:       #0a0a0a;
    surface:      #171717;
    surface-alt:  #222222;

    /* Foreground scale */
    fg:           #ffffff;
    fg-alt:       #ededed;
    muted:        #a1a1a1;
    dim:          #666666;

    /* Accent */
    accent:       #3b82f6;

    /* Layout */
    border-radius: 8px;
    font: "0xProto Nerd Font Mono 13";
}

element-text, element-icon, mode-switcher {
    background-color: transparent;
    text-color:       inherit;
}

window {
    width:            500px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @surface-alt;
    border-radius:    @border-radius;
    padding:          0;
}

mainbox {
    background-color: transparent;
    spacing:          0;
}

inputbar {
    background-color: @bg-alt;
    padding:          16px;
    border:           0 0 1px 0;
    border-color:     @surface-alt;
    children:         [textbox-prompt-colon, entry];
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    padding:          0 12px 0 0;
    text-color:       @muted;
    background-color: transparent;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search...";
    placeholder-color: @dim;
}

listview {
    background-color: transparent;
    padding:          8px 0;
    lines:            8;
    fixed-height:     true;
    scrollbar:        false;
}

element {
    padding:          12px 16px;
    background-color: transparent;
    text-color:       @fg-alt;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg-alt;
}

element selected.normal,
element selected.active {
    background-color: @surface;
    text-color:       @fg;
}

element-icon {
    size:             20px;
    margin:           0 12px 0 0;
}

element-text {
    vertical-align:   0.5;
}

mode-switcher {
    background-color: @bg-alt;
    border:           1px 0 0 0;
    border-color:     @surface-alt;
    padding:          8px;
    spacing:          8px;
}

button {
    padding:          8px 16px;
    background-color: transparent;
    text-color:       @muted;
    border-radius:    4px;
    cursor:           pointer;
}

button selected {
    background-color: @surface;
    text-color:       @fg;
}

message {
    background-color: @bg-alt;
    border:           0 0 1px 0;
    border-color:     @surface-alt;
    padding:          12px 16px;
}

textbox {
    background-color: transparent;
    text-color:       @muted;
}

error-message {
    background-color: @bg;
    text-color:       #ef4444;
    padding:          16px;
}
