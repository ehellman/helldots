#!/usr/bin/env bash
# helldoctor — interactive system maintenance for the Arch machines in this repo.
# Read-only health report + safe, reversible disk-cleanup actions. Surfaces
# (never fixes) the config issues tracked in docs/system-audit.md.
set -euo pipefail

# Inlined shared helpers (chezmoi expands this at apply time): log,
# command_exists, setup_error_handler, reset_sudo, ensure_* ...
{{ template "bash/helpers.sh.tmpl" . }}

# --- globals -----------------------------------------------------------------
CLEAN_ALL=0      # set by --clean-all; when 1, never call gum confirm
REPORT_ONLY=0    # set by --report
SUDO_USED=0      # flipped to 1 the first time we escalate; gates the EXIT reset

usage() {
    cat <<'EOF'
helldoctor — system maintenance

Usage:
  helldoctor              Health report, then interactive cleanup menu (default)
  helldoctor --report     Health report only (Tier A + Tier B), no menu
  helldoctor --clean-all  Run the safe cleanups non-interactively (skips orphans)
  helldoctor --help       This help
EOF
}

# --- pure helpers (side-effect-free, unit-tested) ----------------------------

# format_size <bytes> -> human-readable IEC size, or "n/a" for non-numeric.
format_size() {
    local bytes="${1:-0}"
    if ! [[ "$bytes" =~ ^[0-9]+$ ]]; then
        printf 'n/a'
        return 0
    fi
    # --to=iec-i emits IEC-i labels (KiB/MiB/GiB) and "0B" for zero. Plain
    # --to=iec would emit KB/MB and break the unit tests' KiB/MiB assertions.
    numfmt --to=iec-i --suffix=B "$bytes"
}

# disk_status <free_percent> <min_percent> -> "ok" if free>=min else "warn".
disk_status() {
    local free="$1" min="$2"
    if (( free >= min )); then printf 'ok'; else printf 'warn'; fi
}

# mark <ok|warn> -> check or warning glyph.
mark() {
    case "$1" in
        ok) printf '✓' ;;   # ✓
        *)  printf '⚠' ;;   # ⚠
    esac
}

# --- Tier A probes (instant, local, read-only; each degrades to n/a) ---------

# A probe in a `|| fallback` list triggers neither set -e nor the ERR trap, so
# every probe below either succeeds or yields a safe fallback. Declaration is
# always split from assignment — `local x=$(...)` would mask the exit code
# (SC2155) and the `||` guard would never fire.

probe_disk_free() {
    local pct free status
    pct=$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9') || pct=""
    if [[ -z "$pct" ]]; then printf 'n/a'; return 0; fi
    free=$(( 100 - pct ))
    status=$(disk_status "$free" 10)
    printf '%s%% free %s' "$free" "$(mark "$status")"
}

probe_pkgcache_size() {
    # `|| true`, not `|| out=""`: du still prints the grand total to stdout even
    # when it exits 1 on a root-owned download-* subdir, so keep that total
    # instead of discarding it. ${out:-n/a} still covers a genuinely empty result.
    local out
    out=$(du -sh /var/cache/pacman/pkg 2>/dev/null | cut -f1) || true
    printf '%s' "${out:-n/a}"
}

probe_paru_cache_size() {
    # Same as probe_pkgcache_size: a perms warning on a clone/*/pkg subdir makes
    # du exit 1, but the printed total is still valid — `|| true` keeps it.
    local out
    out=$(du -sh "${HOME}/.cache/paru" 2>/dev/null | cut -f1) || true
    printf '%s' "${out:-n/a}"
}

probe_journal_size() {
    # Unit letter is required (not the trailing B): journalctl prints "2.8G" with
    # no B, and an optional-B regex would also match the sentence's final ".".
    local out
    out=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]i?B?' | tail -1) || out=""
    printf '%s' "${out:-n/a}"
}

probe_trash_size() {
    local t="${HOME}/.local/share/Trash" out
    [[ -d "$t" ]] || { printf 'empty'; return 0; }
    out=$(du -sh "$t" 2>/dev/null | cut -f1) || out=""
    printf '%s' "${out:-n/a}"
}

probe_failed_units() {
    local n names
    n=$(systemctl --failed --no-legend --plain 2>/dev/null | wc -l) || n=0
    [[ -z "$n" ]] && n=0
    if (( n == 0 )); then printf '0 %s' "$(mark ok)"; return 0; fi
    names=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd, -) || names=""
    printf '%s %s (%s)' "$n" "$(mark warn)" "$names"
}

probe_orphans() {
    # pacman -Qdtq exits 1 when there are no orphans; the `|| n=0` covers it.
    local n
    n=$(pacman -Qdtq 2>/dev/null | wc -l) || n=0
    [[ -z "$n" ]] && n=0
    if (( n == 0 )); then printf '0 %s' "$(mark ok)"; else printf '%s %s' "$n" "$(mark warn)"; fi
}

probe_pacfiles() {
    # `|| true`, not `|| n=0`: find exits 1 when it hits a root-only /etc subdir
    # (sudoers.d, NetworkManager/system-connections, …), but wc has already
    # counted every readable match — keep that count instead of false-reporting
    # 0. (A .pacnew inside an unreadable dir is still missed; rare in practice.)
    local n
    n=$(find /etc -type f \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null | wc -l) || true
    [[ -z "$n" ]] && n=0
    if (( n == 0 )); then printf '0 %s' "$(mark ok)"; else printf '%s %s' "$n" "$(mark warn)"; fi
}

probe_mirrorlist_age() {
    local f=/etc/pacman.d/mirrorlist mtime now days
    [[ -r "$f" ]] || { printf 'n/a'; return 0; }
    mtime=$(stat -c %Y "$f" 2>/dev/null) || { printf 'n/a'; return 0; }
    now=$(date +%s)
    days=$(( (now - mtime) / 86400 ))
    if (( days > 30 )); then printf '%sd old %s' "$days" "$(mark warn)"; else printf '%sd old %s' "$days" "$(mark ok)"; fi
}

# timer_status <unit> -> "enabled ✓" or "disabled ⚠". Report-only; never enables.
timer_status() {
    if systemctl is-enabled --quiet "$1" 2>/dev/null; then
        printf 'enabled %s' "$(mark ok)"
    else
        printf 'disabled %s' "$(mark warn)"
    fi
}

probe_power_overlap() {
    # `if cmd; then ...` — NOT `cmd && ppd=1`, which returns non-zero when the
    # unit is disabled and would abort under set -e.
    local ppd=0 ptop=0
    if systemctl is-enabled --quiet power-profiles-daemon 2>/dev/null; then ppd=1; fi
    if systemctl is-enabled --quiet powertop 2>/dev/null; then ptop=1; fi
    if (( ppd && ptop )); then printf 'both enabled %s' "$(mark warn)"; else printf 'ok %s' "$(mark ok)"; fi
}

probe_timeshift() {
    command_exists timeshift || { printf 'n/a (not installed)'; return 0; }
    # sudo -n: non-interactive. If no cached creds, fall back rather than prompt
    # (keeps the report snappy and pipe-safe).
    local out n
    out=$(sudo -n timeshift --list 2>/dev/null) || { printf 'n/a (run with sudo)'; return 0; }
    n=$(printf '%s\n' "$out" | grep -cE '^[0-9]+' ) || n=0
    [[ -z "$n" ]] && n=0
    if (( n == 0 )); then printf 'no snapshots %s' "$(mark warn)"; else printf '%s snapshots %s' "$n" "$(mark ok)"; fi
}

probe_updates() {
    local off aur
    off=$(checkupdates 2>/dev/null | wc -l) || off=0   # checkupdates exits 2 when none
    [[ -z "$off" ]] && off=0
    if command_exists paru; then
        aur=$(paru -Qua 2>/dev/null | wc -l) || aur=0   # exits 1 when none
        [[ -z "$aur" ]] && aur=0
        printf '%s official, %s AUR' "$off" "$aur"
    else
        printf '%s official' "$off"
    fi
}

# spin <title> <cmd...> -> runs cmd under a gum spinner (capturing stdout) or,
# without gum, prints the title to stderr and runs cmd directly. One external
# command per spin, as gum requires.
spin() {
    local title="$1"; shift
    if command_exists gum; then
        gum spin --show-output --title "$title" -- "$@"
    else
        printf '%s...\n' "$title" >&2
        "$@"
    fi
}

# --- Tier B probes (network / full-scan; exit codes UNVERIFIED, see plan) ----
# Real exit codes for arch-audit/checkrebuild/needrestart were not verified at
# design time (the tools weren't installed). Each is wrapped so a non-zero exit
# degrades to a count of 0, never an abort: `|| true` after the captured spin,
# then count the lines. Confirm the true codes at build time (see Step 4).

probe_cve() {
    command_exists arch-audit || { printf 'n/a (arch-audit not installed)'; return 0; }
    local out n
    out=$(spin "Scanning for CVEs" timeout 30 arch-audit -u) || true
    n=$(printf '%s' "${out:-}" | grep -c . ) || n=0
    [[ -z "$n" ]] && n=0
    if (( n > 0 )); then printf '%s vulnerable %s' "$n" "$(mark warn)"; else printf '0 %s' "$(mark ok)"; fi
}

probe_rebuilds() {
    command_exists checkrebuild || { printf 'n/a (rebuild-detector not installed)'; return 0; }
    local out n
    out=$(spin "Checking AUR rebuilds" timeout 60 checkrebuild) || true
    n=$(printf '%s' "${out:-}" | grep -c . ) || n=0
    [[ -z "$n" ]] && n=0
    if (( n > 0 )); then printf '%s need rebuild %s' "$n" "$(mark warn)"; else printf '0 %s' "$(mark ok)"; fi
}

probe_needrestart() {
    command_exists needrestart || { printf 'n/a (needrestart not installed)'; return 0; }
    # Distinguish "couldn't check" from "0 stale services": without cached sudo
    # creds the spin returns empty and would otherwise misreport a healthy 0.
    if ! sudo -n true 2>/dev/null; then printf 'n/a (needs sudo)'; return 0; fi
    local out n
    out=$(spin "Checking stale services" timeout 30 sudo -n needrestart -b) || true
    n=$(printf '%s' "${out:-}" | grep -c 'NEEDRESTART-SVC') || n=0
    [[ -z "$n" ]] && n=0
    if (( n > 0 )); then printf '%s services %s' "$n" "$(mark warn)"; else printf '0 %s' "$(mark ok)"; fi
}

# --- cleanup plumbing --------------------------------------------------------

# run_action <prompt> <fn> [--destructive]
# Confirms (unless --clean-all), then runs fn under a spinner. Confirm exit
# codes: 0 = yes (run), 1 = declined (skip, continue), 130 = Ctrl-C (abort run).
run_action() {
    local prompt="$1" fn="$2" flag="${3:-}"
    local default="--default=true"
    [[ "$flag" == "--destructive" ]] && default="--default=false"

    if (( CLEAN_ALL )); then
        "$fn"
        return 0
    fi

    if ! command_exists gum; then
        local ans
        read -r -p "$prompt [y/N] " ans || { echo "aborted" >&2; exit 130; }
        [[ "$ans" =~ ^[Yy]$ ]] || { log "skipped: $prompt"; return 0; }
        "$fn"
        return 0
    fi

    set +e
    gum confirm "$default" "$prompt"
    local rc=$?
    set -e
    case "$rc" in
        0)   "$fn" ;;
        1)   log "skipped: $prompt" ;;
        130) log "aborted by user"; exit 130 ;;
        # 80 = gum's flag/parse error; any other code falls here too — fail safe
        # by skipping the (possibly destructive) action rather than running it.
        *)   log "confirm error ($rc), skipping: $prompt" ;;
    esac
}

# Each action previews its impact, then does the work. Destructive paths use
# ${VAR:?} so an unset/empty path can never expand to `rm -rf /...`.

clean_pkgcache() {
    log "pacman cache: keeping 2 installed / 0 uninstalled versions"
    SUDO_USED=1
    sudo paccache -rk2
    sudo paccache -ruk0
}

clean_aur_cache() {
    local d="${HOME}/.cache/paru/clone"
    [[ -d "$d" ]] || { log "no paru build cache"; return 0; }
    log "paru build cache size: $(du -sh "$d" 2>/dev/null | cut -f1 || echo n/a)"
    rm -rf "${d:?}"/*
}

vacuum_journal() {
    SUDO_USED=1
    sudo journalctl --vacuum-size=500M
}

empty_trash() {
    local t="${HOME}/.local/share/Trash"
    [[ -d "$t" ]] || { log "trash already empty"; return 0; }
    log "trash size: $(du -sh "$t" 2>/dev/null | cut -f1 || echo n/a)"
    rm -rf "${t:?}"/*
}

# Destructive, interactive only — never called from run_clean_all.
remove_orphans() {
    local orphans
    orphans=$(pacman -Qdtq 2>/dev/null) || orphans=""
    [[ -n "$orphans" ]] || { log "no orphans to remove"; return 0; }
    log "orphans to remove:"; printf '%s\n' "$orphans"
    SUDO_USED=1
    # shellcheck disable=SC2086
    sudo pacman -Rns $orphans
}

prune_dev_caches() {
    local d
    for d in "${HOME}/.cache/yarn" "${HOME}/.local/share/pnpm/store" "${HOME}/.cache/ms-playwright"; do
        [[ -d "$d" ]] || continue
        log "$d: $(du -sh "$d" 2>/dev/null | cut -f1 || echo n/a)"
        rm -rf "${d:?}"
    done
}

# Destructive, $HOME-scoped only — never `find /`.
clean_broken_symlinks() {
    local links
    links=$(find "$HOME" -xtype l 2>/dev/null) || links=""
    [[ -n "$links" ]] || { log "no broken symlinks under \$HOME"; return 0; }
    log "broken symlinks:"; printf '%s\n' "$links"
    printf '%s\n' "$links" | xargs -r rm -v
}

deep_integrity_check() {
    log "running pacman -Qkk (read-only, slow)…"
    pacman -Qkk 2>&1 | grep -vE '0 altered files' || true
}

# Reset sudo only if we actually escalated, so --report stays pipe-clean.
cleanup_on_exit() {
    (( SUDO_USED )) && reset_sudo
    return 0
}

main() {
    setup_error_handler
    trap cleanup_on_exit EXIT

    case "${1:-}" in
        --help|-h) usage; return 0 ;;
        --report)  REPORT_ONLY=1 ;;
        --clean-all) CLEAN_ALL=1 ;;
        "") ;;
        *) echo "helldoctor: unknown option '$1'" >&2; usage >&2; return 2 ;;
    esac

    if (( CLEAN_ALL )); then
        run_clean_all
        return 0
    fi

    render_report_tier_a
    if (( REPORT_ONLY )); then
        render_report_tier_b
        return 0
    fi
    cleanup_menu
}

# --- stubs (filled in by later tasks) ----------------------------------------
render_report_tier_a() {
    local lines=()
    lines+=("# helldoctor — health report")
    lines+=("")
    lines+=("## Tier A — local")
    lines+=("- **Disk /**            $(probe_disk_free)")
    lines+=("- **Pacman cache**      $(probe_pkgcache_size)")
    lines+=("- **paru cache**        $(probe_paru_cache_size)")
    lines+=("- **Journal**           $(probe_journal_size)")
    lines+=("- **Trash**             $(probe_trash_size)")
    lines+=("- **Failed units**      $(probe_failed_units)")
    lines+=("- **Orphan packages**   $(probe_orphans)")
    lines+=("- **.pacnew/.pacsave**  $(probe_pacfiles)")
    lines+=("- **Mirrorlist**        $(probe_mirrorlist_age)")
    lines+=("- **fstrim.timer**      $(timer_status fstrim.timer)")
    lines+=("- **paccache.timer**    $(timer_status paccache.timer)")
    lines+=("- **Power tooling**     $(probe_power_overlap)")
    lines+=("- **Timeshift**         $(probe_timeshift)")
    lines+=("- **Pending updates**   $(probe_updates)")
    lines+=("")
    lines+=("> ⚠ items are config issues — see docs/system-audit.md (not auto-fixed).")
    # Pretty when glanceable (interactive TTY); plain markdown when piped or
    # redirected, so `helldoctor --report | foo` is parseable. The spec calls
    # --report "glanceable / pipeable" — the `[[ -t 1 ]]` gate satisfies both.
    # (Tier B spinner output is captured per-probe into $out, so nothing else
    # leaks to stdout; gum format's ANSI is the only pipeability concern.)
    if command_exists gum && [[ -t 1 ]]; then
        printf '%s\n' "${lines[@]}" | gum format
    else
        printf '%s\n' "${lines[@]}"
    fi
}
render_report_tier_b() {
    local cve rebuilds restart lines=()
    cve=$(probe_cve)
    rebuilds=$(probe_rebuilds)
    restart=$(probe_needrestart)
    lines+=("## Tier B — security & upgrade readiness")
    lines+=("- **Open CVEs**             $cve")
    lines+=("- **AUR rebuilds needed**   $rebuilds")
    lines+=("- **Stale-lib services**    $restart")
    lines+=("- **Arch news**             before \`-Syu\`, check archlinux.org/news")
    # Pretty when glanceable (interactive TTY); plain markdown when piped or
    # redirected, so `helldoctor --report | foo` is parseable. The spec calls
    # --report "glanceable / pipeable" — the `[[ -t 1 ]]` gate satisfies both.
    # (Tier B spinner output is captured per-probe into $out, so nothing else
    # leaks to stdout; gum format's ANSI is the only pipeability concern.)
    if command_exists gum && [[ -t 1 ]]; then
        printf '%s\n' "${lines[@]}" | gum format
    else
        printf '%s\n' "${lines[@]}"
    fi
}
cleanup_menu() {
    if ! command_exists gum; then
        cleanup_menu_fallback
        return 0
    fi
    local choices
    # gum choose exits non-zero if the user presses Esc; treat that as "nothing".
    set +e
    choices=$(gum choose --no-limit --header "Select cleanup actions (space to mark, enter to run):" \
        "Trim pacman cache" \
        "Clean AUR build cache" \
        "Vacuum journal" \
        "Empty trash" \
        "Prune dev caches" \
        "Deep integrity check (slow)" \
        "Clean broken symlinks (HOME)" \
        "Remove orphan packages")
    set -e
    [[ -n "$choices" ]] || { log "nothing selected"; return 0; }

    local choice
    while IFS= read -r choice; do
        case "$choice" in
            "Trim pacman cache")            run_action "Trim pacman cache?" clean_pkgcache ;;
            "Clean AUR build cache")        run_action "Clear paru build cache?" clean_aur_cache ;;
            "Vacuum journal")               run_action "Vacuum journal to 500M?" vacuum_journal ;;
            "Empty trash")                  run_action "Empty trash?" empty_trash ;;
            "Prune dev caches")             run_action "Prune yarn/pnpm/playwright caches?" prune_dev_caches ;;
            "Deep integrity check (slow)")  run_action "Run pacman -Qkk integrity check?" deep_integrity_check ;;
            "Clean broken symlinks (HOME)") run_action "Delete broken symlinks under \$HOME?" clean_broken_symlinks --destructive ;;
            "Remove orphan packages")       run_action "Remove orphan packages?" remove_orphans --destructive ;;
        esac
    done <<< "$choices"
}
# Plain-bash menu used when gum is unavailable. run_action's own non-gum branch
# still requires a y/N confirm before any destructive action.
cleanup_menu_fallback() {
    echo "gum not found — using plain menu. Install it with: sudo pacman -S gum" >&2
    local options=(
        "Trim pacman cache:clean_pkgcache:"
        "Clean AUR build cache:clean_aur_cache:"
        "Vacuum journal:vacuum_journal:"
        "Empty trash:empty_trash:"
        "Prune dev caches:prune_dev_caches:"
        "Deep integrity check (slow):deep_integrity_check:"
        "Clean broken symlinks (HOME):clean_broken_symlinks:--destructive"
        "Remove orphan packages:remove_orphans:--destructive"
    )
    local i entry label fn flag
    for i in "${!options[@]}"; do
        IFS=: read -r label _ _ <<< "${options[$i]}"
        printf '%2d) %s\n' "$((i + 1))" "$label"
    done
    local picks
    read -r -p "Select numbers (space-separated, empty to skip): " picks || return 0
    [[ -n "$picks" ]] || { log "nothing selected"; return 0; }
    local n
    for n in $picks; do
        # ^[1-9]…: reject 0, else $((0-1)) -> options[-1] (bash last elem) would
        # mis-map "0" to the most destructive action.
        [[ "$n" =~ ^[1-9][0-9]*$ ]] || continue
        entry="${options[$((n - 1))]:-}"
        [[ -n "$entry" ]] || continue
        IFS=: read -r label fn flag <<< "$entry"
        run_action "$label?" "$fn" "$flag"
    done
}
# Safe, reversible cleanups only. No confirms (CLEAN_ALL gates run_action), and
# deliberately NO remove_orphans / clean_broken_symlinks — those need human eyes.
run_clean_all() {
    log "running safe cleanups non-interactively"
    run_action "Trim pacman cache" clean_pkgcache
    run_action "Clean AUR build cache" clean_aur_cache
    run_action "Vacuum journal" vacuum_journal
    run_action "Empty trash" empty_trash
    run_action "Prune dev caches" prune_dev_caches
    log "clean-all complete"
}

# Sourcing guard: run main only when executed, not when sourced by tests.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
